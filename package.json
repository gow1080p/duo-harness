{
  "name": "duo-harness",
  "version": "1.0.0",
  "description": "Zero-host-lock-in Functional Core + Imperative Shell TypeScript Agent Harness",
  "type": "module",
  "main": "./src/index.ts",
  "exports": {
    ".": "./src/index.ts"
  },
  "engines": {
    "node": ">=22.0.0"
  },
  "scripts": {
    "play": "tsx play.ts",
    "ask": "tsx src/adapters/cli.ts",
    "review": "tsx src/adapters/reviewer.ts",
    "serve": "tsx src/adapters/rpc-server.ts",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "verify": "tsc --noEmit && vitest run"
  },
  "dependencies": {
    "zod": "^3.24.2"
  },
  "devDependencies": {
    "@types/node": "^22.13.4",
    "tsx": "^4.19.3",
    "typescript": "^5.7.3",
    "vitest": "^3.0.6"
  }
}
